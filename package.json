{
  "name": "tournova",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "integration:target": "node scripts/integration-target.mjs",
    "backup:production": "node scripts/backup-production.mjs",
    "restore:to-local": "node scripts/restore-backup.mjs",
    "ci:shard-plan": "node scripts/shard-plan.mjs",
    "bench:scheduling": "vitest run --config vitest.benchmark.config.ts",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:final": "E2E_REQUIRE_STAFF=1 playwright test && node scripts/assert-no-skips.mjs",
    "test:all": "npm run test && npm run test:e2e",
    "test:e2e:record-auth": "node scripts/record-staff-session.mjs",
    "db:link": "supabase link --project-ref \"$SUPABASE_PROJECT_ID\"",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --linked > src/integrations/supabase/types.ts",
    "db:parity": "node scripts/run-sql.mjs scripts/parity-dump.sql",
    "db:drift": "node scripts/run-sql.mjs scripts/migration-drift-check.sql",
    "deploy:check": "npm run build && node scripts/verify-build-target.mjs && wrangler deploy --dry-run",
    "deploy:dry": "npm run deploy:check",
    "deploy": "npm run build && node scripts/verify-build-target.mjs && wrangler deploy"
  },
  "overrides": {
    "rolldown": "1.2.1"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@supabase/supabase-js": "^2.116.0",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-start": "1.168.32",
    "@tanstack/router-plugin": "1.168.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "vite-tsconfig-paths": "^6.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "jsdom": "^29.1.1",
    "lightningcss": "^1.33.0",
    "nitro": "3.0.260603-beta",
    "pg": "^8.23.0",
    "prettier": "^3.7.3",
    "supabase": "^2.117.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "8.1.5",
    "vitest": "^3.2.4",
    "wrangler": "4.135.0"
  }
}
